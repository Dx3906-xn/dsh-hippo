{
  "name": "dsh-hippo",
  "version": "0.1.0",
  "description": "Cognitive long-term memory for DSH companion agents: episodic memory, semantic facts, forgetting curves, and relational state.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "companion",
    "agent",
    "cognitive",
    "ebbinghaus",
    "fsrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dx3906-xn/dsh-hippo.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": false },
    "@deepseek-ai/dsh-agent": { "optional": false },
    "@deepseek-ai/dsh-llm": { "optional": false },
    "@deepseek-ai/dsh-session": { "optional": false },
    "@deepseek-ai/dsh-system-prompt": { "optional": false },
    "@deepseek-ai/dsh-tools": { "optional": false },
    "@deepseek-ai/schemastery": { "optional": false }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
